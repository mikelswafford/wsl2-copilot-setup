#!/usr/bin/env bash
# Git credential helper that authenticates https://github.com operations
# with a short-lived GitHub App installation access token, instead of a
# personal access token.
#
# Wire this in with:
#   git config --global credential.helper '!github-app-credential'
set -euo pipefail

operation="${1:-}"
protocol=""
host=""

while IFS='=' read -r key value; do
  case "$key" in
    protocol) protocol="$value" ;;
    host) host="$value" ;;
  esac
done

if [[ "$operation" != "get" || "$protocol" != "https" ||
  ( "$host" != "github.com" && "$host" != "github.com:443" ) ]]; then
  exit 0
fi

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
token=$(python3 "$script_dir/get-github-app-token.py")

if [[ "$token" != ghs_* ]]; then
  printf 'get-github-app-token.py did not return an installation token.\n' >&2
  exit 1
fi

printf '%s\n' \
  'username=x-access-token' \
  "password=$token"
